{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "probe3-readiness/absence-plan.schema.json",
  "title": "Probe 3 absence plan (doctrine v0.1, unratified)",
  "description": "One founder-absence plan. Every person reference is a ROLE LABEL declared in `roles` (for example 'Holder A'). Fields named `name` or `email` are rejected anywhere in the document. Real plans live in gitignored *.local.json files.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "planVersion",
    "doctrineStatus",
    "planId",
    "absence",
    "roles",
    "responseWindow",
    "emergencyInterrupts",
    "scope",
    "heartbeat",
    "runwayGate",
    "formation",
    "reunion",
    "rehearsals"
  ],
  "properties": {
    "$schema": { "type": "string" },
    "planVersion": { "const": "0.1" },
    "doctrineStatus": {
      "const": "v0.1-unratified",
      "description": "All doctrine behind this plan is v0.1 and unratified."
    },
    "planId": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
    "absence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["probe", "departureDate", "founderRole", "primaryHolder", "primaryBackup"],
      "properties": {
        "probe": { "type": "string", "minLength": 1 },
        "departureDate": { "type": "string", "format": "date" },
        "returnDate": { "type": ["string", "null"], "format": "date" },
        "founderRole": { "$ref": "#/$defs/roleLabel" },
        "primaryHolder": { "$ref": "#/$defs/roleRefOrEmpty" },
        "primaryBackup": { "$ref": "#/$defs/roleRefOrEmpty" }
      }
    },
    "roles": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["label", "kind"],
        "properties": {
          "label": { "$ref": "#/$defs/roleLabel" },
          "kind": { "enum": ["founder", "co-driver", "holder", "welcomer", "member", "other"] }
        }
      }
    },
    "thresholds": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "maxScopePerHolder": {
          "type": "integer",
          "minimum": 1,
          "description": "A holder carrying MORE than this many scope items is a single point of failure. Default 5."
        }
      }
    },
    "responseWindow": {
      "type": "object",
      "additionalProperties": false,
      "required": ["cadence", "day"],
      "properties": {
        "cadence": { "enum": ["weekly", "unset"] },
        "day": {
          "enum": ["monday", "tuesday", "wednesday", "thursday", "friday", "saturday", "sunday", "unset"]
        }
      }
    },
    "emergencyInterrupts": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["class", "firstResponder"],
        "properties": {
          "class": { "enum": ["harm_to_person", "reputational_damage", "money_legal"] },
          "firstResponder": { "$ref": "#/$defs/roleRefOrEmpty" }
        }
      }
    },
    "scope": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "title", "holder", "backup"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
          "title": { "type": "string", "minLength": 1 },
          "holder": { "$ref": "#/$defs/roleRefOrEmpty" },
          "backup": { "$ref": "#/$defs/roleRefOrEmpty" },
          "runsWithoutFounder": { "type": ["boolean", "null"] }
        }
      }
    },
    "heartbeat": {
      "type": "object",
      "additionalProperties": false,
      "required": ["peerSession", "asyncPulse", "warmthLoop"],
      "properties": {
        "peerSession": {
          "type": "object",
          "additionalProperties": false,
          "required": ["cadence", "rotatingHost", "holder"],
          "properties": {
            "cadence": { "enum": ["weekly", "biweekly", "monthly", "unset"] },
            "rotatingHost": { "type": "boolean" },
            "holder": { "$ref": "#/$defs/roleRefOrEmpty" }
          }
        },
        "asyncPulse": {
          "type": "object",
          "additionalProperties": false,
          "required": ["cadence", "holder"],
          "properties": {
            "cadence": { "enum": ["weekly", "biweekly", "monthly", "unset"] },
            "holder": { "$ref": "#/$defs/roleRefOrEmpty" }
          }
        },
        "warmthLoop": {
          "type": "object",
          "additionalProperties": false,
          "required": ["messagesPlanned", "holder"],
          "properties": {
            "messagesPlanned": { "type": "integer", "minimum": 0 },
            "holder": { "$ref": "#/$defs/roleRefOrEmpty" }
          }
        }
      }
    },
    "runwayGate": {
      "type": "object",
      "description": "Facts for the Runway v0.1 Phase 4 -> T-0 gate. The gate text is the same in archived variants 023 and 024; the variants are unreconciled and the kit does not pick one.",
      "additionalProperties": false,
      "required": ["coastPageWritten", "handoffRitualDone", "zeroOpsWeek"],
      "properties": {
        "coastPageWritten": { "type": "boolean", "description": "The written handoff / coast page exists." },
        "handoffRitualDone": { "type": "boolean" },
        "zeroOpsWeek": {
          "type": ["object", "null"],
          "additionalProperties": false,
          "required": ["start", "end", "founderInterventions"],
          "properties": {
            "start": { "type": "string", "format": "date" },
            "end": { "type": "string", "format": "date" },
            "founderInterventions": { "type": "integer", "minimum": 0 }
          }
        }
      }
    },
    "formation": {
      "type": "object",
      "description": "Branch C inputs: entering the absence under-prepared.",
      "additionalProperties": false,
      "required": ["ownersBesidesFounder", "coDriverVacuumLevel3Passed"],
      "properties": {
        "ownersBesidesFounder": { "type": "integer", "minimum": 0 },
        "coDriverVacuumLevel3Passed": { "type": "boolean" }
      }
    },
    "reunion": {
      "type": "object",
      "additionalProperties": false,
      "required": ["date"],
      "properties": {
        "date": { "type": ["string", "null"], "format": "date" },
        "announced": { "type": "boolean" }
      }
    },
    "rehearsals": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["date", "kind", "holderActedWithoutFounder"],
        "properties": {
          "date": { "type": "string", "format": "date" },
          "kind": { "enum": ["live-step-back", "tabletop"] },
          "durationDays": { "type": "integer", "minimum": 1 },
          "holderActedWithoutFounder": { "type": "boolean" },
          "notes": { "type": "string" }
        }
      }
    }
  },
  "$defs": {
    "roleLabel": {
      "type": "string",
      "minLength": 1,
      "maxLength": 40,
      "pattern": "^[^@<>]+$",
      "description": "A role word, never a person's name or contact."
    },
    "roleRefOrEmpty": {
      "type": "string",
      "maxLength": 40,
      "pattern": "^[^@<>]*$",
      "description": "A label from `roles`, or empty string when nobody holds it yet (reported as a gap)."
    }
  }
}
