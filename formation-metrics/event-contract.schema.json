{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://riseup.invalid/formation-metrics/event-contract.v1.schema.json",
  "title": "RiseUp formation event (one line of events.jsonl), contract v1",
  "description": "Events carry opaque ids only. Names, contact details, scores, ranks and stage moves are rejected. src/contract.ts enforces the same rules at parse time and also rejects email-shaped values anywhere.",
  "$defs": {
    "eventType": {
      "enum": [
        "slot.opened", "ownership.unprompted", "intake.day0", "intake.first_ship", "intake.beat",
        "decision.logged", "deliverable.shipped", "pod.session", "capacity.snapshot",
        "rescue", "gap", "stepped_in", "card",
        "participant.impact", "capability.demonstrated", "leader.created", "replication.signal"
      ]
    },
    "personId": { "type": "string", "pattern": "^p_[a-z0-9]{3,32}$", "description": "Opaque person id. Never a name." },
    "opaqueId": { "type": "string", "pattern": "^[a-z]{1,6}_[a-z0-9]{1,32}$" },
    "at": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}" },
    "summary": { "type": "string", "maxLength": 280 },
    "count": { "type": "integer", "minimum": 0 },
    "hours": { "type": "number", "minimum": 0 },
    "common": {
      "v": { "const": 1 },
      "at": { "$ref": "#/$defs/at" },
      "source": { "type": "string" }
    }
  },
  "type": "object",
  "required": ["v", "type", "at"],
  "properties": { "type": { "$ref": "#/$defs/eventType" } },
  "oneOf": [
    {
      "properties": { "v": { "const": 1 }, "type": { "const": "slot.opened" }, "at": { "$ref": "#/$defs/at" }, "source": { "type": "string" }, "slotId": { "$ref": "#/$defs/opaqueId" } },
      "required": ["slotId"], "additionalProperties": false
    },
    {
      "properties": {
        "v": { "const": 1 }, "type": { "const": "ownership.unprompted" }, "at": { "$ref": "#/$defs/at" }, "source": { "type": "string" },
        "subject": { "$ref": "#/$defs/personId" }, "slotId": { "$ref": "#/$defs/opaqueId" }, "byCoDriver": { "type": "boolean" },
        "stage": { "type": "integer", "minimum": 0, "maximum": 5, "description": "Numeric only; labels live in config." }
      },
      "required": ["subject"], "additionalProperties": false
    },
    {
      "properties": { "v": { "const": 1 }, "type": { "enum": ["intake.day0", "intake.first_ship"] }, "at": { "$ref": "#/$defs/at" }, "source": { "type": "string" }, "subject": { "$ref": "#/$defs/personId" } },
      "required": ["subject"], "additionalProperties": false
    },
    {
      "properties": {
        "v": { "const": 1 }, "type": { "const": "intake.beat" }, "at": { "$ref": "#/$defs/at" }, "source": { "type": "string" },
        "subject": { "$ref": "#/$defs/personId" }, "beat": { "enum": ["named_human_thanks", "real_task", "feedback", "social_tie"] }
      },
      "required": ["subject", "beat"], "additionalProperties": false
    },
    {
      "properties": {
        "v": { "const": 1 }, "type": { "const": "pod.session" }, "at": { "$ref": "#/$defs/at" }, "source": { "type": "string" },
        "podId": { "$ref": "#/$defs/opaqueId" }, "expected": { "$ref": "#/$defs/count" }, "attended": { "$ref": "#/$defs/count" },
        "founderRescue": { "type": "boolean" }, "facilitatorHours": { "$ref": "#/$defs/hours" }
      },
      "required": ["podId", "expected", "attended", "founderRescue"], "additionalProperties": false
    },
    {
      "properties": {
        "v": { "const": 1 }, "type": { "const": "capacity.snapshot" }, "at": { "$ref": "#/$defs/at" }, "source": { "type": "string" },
        "activeWelcomers": { "$ref": "#/$defs/count" }, "availableHours": { "$ref": "#/$defs/hours" }, "hoursPerEntrant": { "$ref": "#/$defs/hours" }
      },
      "required": ["activeWelcomers", "availableHours", "hoursPerEntrant"], "additionalProperties": false
    },
    {
      "properties": {
        "v": { "const": 1 }, "type": { "const": "stepped_in" }, "at": { "$ref": "#/$defs/at" }, "source": { "type": "string" },
        "actor": { "$ref": "#/$defs/personId" }, "summary": { "$ref": "#/$defs/summary" }
      },
      "additionalProperties": false
    },
    {
      "properties": {
        "v": { "const": 1 },
        "type": { "enum": ["decision.logged", "deliverable.shipped", "rescue", "gap", "card", "participant.impact", "capability.demonstrated", "leader.created", "replication.signal"] },
        "at": { "$ref": "#/$defs/at" }, "source": { "type": "string" }, "summary": { "$ref": "#/$defs/summary" }
      },
      "additionalProperties": false
    }
  ]
}
